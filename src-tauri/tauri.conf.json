{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space语音输入法",
  "version": "0.1.0",
  "identifier": "com.space.voice.input",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Space 语音输入法",
        "url": "index.html",
        "width": 520,
        "height": 480,
        "minWidth": 440,
        "minHeight": 380,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}